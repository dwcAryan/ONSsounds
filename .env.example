# ONS SOUND - Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production environment.

# Application Settings
APP_NAME="ONS SOUND"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/ONSsounds/
APP_TIMEZONE=Asia/Kolkata

# Database Settings (PDO MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=onssound_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mailer Settings (PHPMailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=sharmatripti2106@gmail.com
SMTP_FROM_NAME="ONS SOUND"

# Security Keys
SESSION_LIFETIME=7200
CSRF_SECRET=
